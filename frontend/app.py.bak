with st.sidebar:
    st.markdown(
        """
        <div class="sidebar-brand">
            <span style="font-size:24px;">🏥</span>
            <div>
                <h3>SwasthAI</h3>
                <span style="font-size:11px;color:#64748b;font-weight:600;">Patient Access</span>
            </div>
        </div>
        """,
        unsafe_allow_html=True
    )
    
    st.markdown('<div class="patient-info-label">Patient Name</div>', unsafe_allow_html=True)
    st.markdown(f'<div class="patient-info-value">👤 {patient.get("full_name", "Patient")}</div>', unsafe_allow_html=True)

    st.markdown('<div class="patient-info-label">Patient ID (Pseudonym)</div>', unsafe_allow_html=True)
    st.markdown(f'<div class="patient-info-value">🆔 {patient.get("pseudonym_id", "N/A")}</div>', unsafe_allow_html=True)

    st.markdown('<div class="patient-info-label">Mobile Number</div>', unsafe_allow_html=True)
    st.markdown(f'<div class="patient-info-value">📞 {patient.get("phone_number", "N/A")}</div>', unsafe_allow_html=True)

    st.markdown('<div class="patient-info-label">Date of Birth / Age</div>', unsafe_allow_html=True)
    st.markdown(f'<div class="patient-info-value">📅 {patient.get("dob", "N/A")} ({patient.get("age", 25)} yrs)</div>', unsafe_allow_html=True)

    st.markdown('<div class="patient-info-label">Gender</div>', unsafe_allow_html=True)
    st.markdown(f'<div class="patient-info-value">⚧ {patient.get("sex", "UNKNOWN")}</div>', unsafe_allow_html=True)

    st.markdown("<br/>", unsafe_allow_html=True)
