"""
SwasthAI Clinical Decision Support System — Patient Health Portal
================================================================
Patient-Facing Clinical Interface for Satnavari Smart Village Healthpod.
Replicates the clinical encounter reference design with:
- Narrow Left Sidebar for Patient Access & Demographics
- Prominent Dark Teal Header Banner with Gold Accent
- Two-Column Encounter Form:
    * Left Panel: Healthpod Vitals with Dynamic BMI & Summary Pills
    * Right Panel: Diagnostic Scan Upload, Lung Sound Recording, and Lab Report Upload
- Two Lab Data Entry Methods:
    1. Automated Extraction from Uploaded Reports (PDF/Image) with Review & Edit Table
    2. Manual Laboratory Data Entry (Add/Remove Rows, Custom & Suggested Tests)
- Full Encounter Submission to SwasthAI Multimodal Pipeline & Relational SQLite DB
"""

import sys
import os
import uuid
import json
import math
from pathlib import Path
from datetime import datetime

# ---------------------------------------------------------------------------
# Path setup
# ---------------------------------------------------------------------------
_PROJECT_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if _PROJECT_ROOT not in sys.path:
    sys.path.insert(0, _PROJECT_ROOT)

# ---------------------------------------------------------------------------
# Streamlit & PyArrow compatibility hook
# ---------------------------------------------------------------------------
try:
    import pyarrow.lib  # noqa: F401
except Exception:
    import streamlit.elements.arrow as _arrow
    import pandas as _pd

    def _safe_df_display(self, data=None, *args, **kwargs):
        if data is not None:
            if isinstance(data, _pd.DataFrame):
                hide_index = kwargs.get("hide_index", False)
                cols = list(data.columns)
                header = "| " + " | ".join(str(c) for c in cols) + " |"
                sep = "| " + " | ".join(["---"] * len(cols)) + " |"
                rows = ["| " + " | ".join(str(row[c]) for c in cols) + " |" for _, row in data.iterrows()]
                return self.dg.markdown("\n".join([header, sep] + rows))
            return self.dg.write(data)
        return self.dg

    _arrow.ArrowMixin.dataframe = _safe_df_display
    import streamlit as _st
    _st.dataframe = _safe_df_display.__get__(_st._main)

import streamlit as st
import pandas as pd
from backend.app.db.session import init_db, get_db_connection
from backend.app.core.privacy import hash_identifier
from backend.app.services.pipeline import pipeline
from backend.app.ehr.patient_service import patient_ehr_service
from backend.app.agents.vision_agent.service import vision_agent_service
from backend.app.services.document_extractor import extract_text_from_file, extract_and_structure_labs

# Ensure database tables & demo patient are ready
init_db()

# ---------------------------------------------------------------------------
# Streamlit Page Configuration
# ---------------------------------------------------------------------------
st.set_page_config(
    page_title="SwasthAI – Satnavari Healthpod",
    page_icon="🏥",
    layout="wide",
    initial_sidebar_state="expanded"
)

# ---------------------------------------------------------------------------
# Authentication Guard: Patient-Only Access
# ---------------------------------------------------------------------------
if "patient_user" not in st.session_state or st.session_state["patient_user"] is None:
    # Auto-login to seeded demo patient for immediate seamless demonstration
    with get_db_connection() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT id, pseudonym_id, full_name, phone_number, email, dob, age, sex, is_pregnant FROM patients WHERE phone_number = '9876543210';")
        demo_row = cursor.fetchone()
        if demo_row:
            st.session_state["patient_user"] = {
                "patient_id": demo_row["id"],
                "id": demo_row["id"],
                "pseudonym_id": demo_row["pseudonym_id"],
                "full_name": demo_row["full_name"],
                "phone_number": demo_row["phone_number"],
                "email": demo_row["email"] or "aarav.patel@satnavari.in",
                "dob": demo_row["dob"] or "1994-06-15",
                "age": demo_row["age"] or 30,
                "sex": demo_row["sex"] or "MALE",
                "is_pregnant": bool(demo_row["is_pregnant"]),
                "role": "patient"
            }
            st.session_state["user"] = st.session_state["patient_user"]
            st.session_state["selected_patient_id"] = demo_row["id"]
        else:
            st.warning("Please sign in to access your Patient Portal.")
            if st.button("Proceed to Patient Login", type="primary"):
                st.switch_page("pages/01_Login.py")
            st.stop()

patient = st.session_state["patient_user"]

# Initialize session state for encounter data & uploads
if "manual_labs" not in st.session_state:
    st.session_state["manual_labs"] = [
        {"test_name": "Hemoglobin", "value": 13.5, "unit": "g/dL", "reference_interval": "12.0 - 16.0", "status": "Normal", "source": "Manual Entry", "verified": True},
        {"test_name": "Platelets", "value": 240000, "unit": "/uL", "reference_interval": "150000 - 450000", "status": "Normal", "source": "Manual Entry", "verified": True}
    ]

if "extracted_labs" not in st.session_state:
    st.session_state["extracted_labs"] = []

if "uploaded_scan_info" not in st.session_state:
    st.session_state["uploaded_scan_info"] = None

if "uploaded_audio_info" not in st.session_state:
    st.session_state["uploaded_audio_info"] = None

if "uploaded_doc_info" not in st.session_state:
    st.session_state["uploaded_doc_info"] = None

if "last_encounter_result" not in st.session_state:
    st.session_state["last_encounter_result"] = None

# Ensure temp upload directory exists
UPLOAD_DIR = Path(_PROJECT_ROOT) / "data" / "uploads"
UPLOAD_DIR.mkdir(parents=True, exist_ok=True)

