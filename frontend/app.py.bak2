# -*- coding: utf-8 -*-
"""
SwasthAI — Healthpod Operator Hub
============================================================
Central dashboard for authorized Healthpod Operators.

POST-LOGIN FLOW:
  1. Operator logs in via /auth/login (FastAPI backend)
  2. Frontend stores operator session
  3. This hub shows ONLY two primary actions:
       - Register a New Patient
       - Login an Existing Patient
"""

import sys
import os
from pathlib import Path

_PROJECT_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if _PROJECT_ROOT not in sys.path:
    sys.path.insert(0, _PROJECT_ROOT)

import streamlit as st

# Ensure DB tables seeded
from backend.app.db.session import init_db
init_db()

st.set_page_config(
    page_title="SwasthAI — Healthpod Operator",
    page_icon="🏥",
    layout="wide",
    initial_sidebar_state="collapsed",
)

# Inject myAadhaar-inspired theme
from frontend.common import inject_css, init_session, get_current_operator
inject_css()
init_session()

# Authentication guard
operator = get_current_operator()
if not operator:
    st.error("❌ You must be signed in as a Healthpod Operator to continue.")
    if st.button("Go to Login"):
        st.switch_page("pages/01_Login.py")
    st.stop()

# ---------------------------------------------------------------------------
# HEADER
# ---------------------------------------------------------------------------
render_header = None
from frontend.common import render_operator_header
render_operator_header("Healthpod Operator Hub", subtitle="SwasthAI — Satnavri Healthpod")

st.markdown(
    '<div class="card" style="padding:18px;border:1px solid var(--border);">'
    '<p style="margin:0 0 8px 0;font-size:15px;"><strong>Welcome,</strong> '
    f'<span style="color:#004d80;">{operator.get("full_name","Healthpod Operator")}</span> '
    '&#183; Authorized Healthpod Operator. Select a patient action below.</p>'
    '</div>',
    unsafe_allow_html=True,
)

# ---------------------------------------------------------------------------
# THE TWO PRIMARY OPTIONS (requirement: only two)
# ---------------------------------------------------------------------------
st.markdown("### 🎯 Primary Actions")
st.caption("Every Healthpod Operator workflow begins with one of these two actions.")

col_a, col_b = st.columns(2)

with col_a:
    st.markdown(
        '<div class="card" style="text-align:center;padding:24px;border:2px solid var(--primary);border-radius:var(--radius-lg);">'
        '<div style="font-size:40px;margin-bottom:10px;">➕</div>'
        '<h3 style="margin:0 0 6px 0;font-size:20px;">Register a New Patient</h3>'
        '<p style="margin:0;color:#5c6b7a;font-size:14px;">Create a new patient record, '
        'generate a Patient ID, and open a new consultation.</p>'
        '<button class="btn btn-primary btn-block" onclick="changePage(&#39;pages/03_Register_Patient.py&#39)">'
        'Register New Patient</button>'
        '</div>',
        unsafe_allow_html=True,
    )

with col_b:
    st.markdown(
        '<div class="card" style="text-align:center;padding:24px;border:2px solid var(--primary);border-radius:var(--radius-lg);">'
        '<div style="font-size:40px;margin-bottom:10px;">🔐</div>'
        '<h3 style="margin:0 0 6px 0;font-size:20px;">Login an Existing Patient</h3>'
        '<p style="margin:0;color:#5c6b7a;font-size:14px;">Search for an existing patient by phone number, '
        'patient ID, or pseudonym, then open a new consultation for that patient.</p>'
        '<button class="btn btn-primary btn-block" onclick="changePage('\'pages/04_Search_Patients.py\')">'
        'Login Existing Patient</button>'
        '</div>',
        unsafe_allow_html=True,
    )

# ---------------------------------------------------------------------------
# ACTIVE CONSULTATIONS (quick reference — compact, not a dashboard)
# ---------------------------------------------------------------------------
st.markdown("---")
st.markdown("### 💠 Your Active Consultations")
with st.expander("View / open an existing consultation", expanded=False):
    with get_db_connection() as conn:
        cur = conn.cursor()
        cur.execute(
            "SELECT c.id, c.encounter_date, p.pseudonym_id, c.status "
            "FROM consultations c JOIN patients p ON p.id = c.patient_id "
            "WHERE c.operator_id = ? ORDER BY c.encounter_date DESC LIMIT 20;",
            (operator["id"],),
        )
        rows = cur.fetchall()
    if rows:
        for enc_id, enc_date, pat_id, status in rows:
            st.markdown(
                f'<div class="patient-chip">'
                f'<span>{enc_id}</span>'
                f'<span class="id">{pat_id} &nbsp;·&nbsp; {enc_date} &nbsp;·&nbsp; {status}</span>'
                f'</div>',
                unsafe_allow_html=True,
            )
    else:
        st.info("No active consultations yet. Use the two primary actions above.")

st.markdown(
    '<div class="footer">'
    '<p>&#128188; SwasthAI — Clinical Decision Support for Healthpod Operators. '
    'Not a substitute for licensed medical judgment.</p>'
    '</div>',
    unsafe_allow_html=True,
)
