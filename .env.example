# SwasthAI Environment Configuration Example
# Copy this file to .env and customize for your deployment environment

# Server & API Configuration
SWASTHAI_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
STREAMLIT_PORT=8501

# Security & Authentication
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Database Configuration (SQLite with foreign keys enabled)
DATABASE_URL=sqlite:///./swasthai.db
ENABLE_SQLITE_FOREIGN_KEYS=true

# Model & Inference Settings (Optimized for RTX 3050 6GB Laptop GPU)
MAX_ACTIVE_MODELS=1
DEVICE=cuda
FALLBACK_DEVICE=cpu
MAX_VRAM_ALLOCATION_MB=5000
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct
ENABLE_DETERMINISTIC_FALLBACK=true

# Respiratory Acoustic Model
RESPIRATORY_MODEL_PATH=./ml/respiratory/checkpoints/best_crnn.pt
AUDIO_SAMPLE_RATE=16000
AUDIO_MEL_BINS=64
AUDIO_SEGMENT_DURATION_SEC=5.0
BATCH_SIZE=8

# RAG & Knowledge Base
VECTOR_DB_DIR=./data/knowledge_base/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_DISTANCE_THRESHOLD=0.35

# Storage & Upload Limits (in bytes, 15MB max)
MAX_UPLOAD_SIZE_BYTES=15728640
UPLOAD_DIR=./data/uploads
